<UserControl x:Class="WpfApp3.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:WpfApp3.Models"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}"/>

        <!-- 卡片宽度随可用宽度自动调整（代码中更新），高度固定，便于按行虚拟化 -->
        <sys:Double x:Key="CardWidth">178</sys:Double>

        <Style x:Key="CardDescription" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Margin" Value="0,9,0,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="MaxHeight" Value="48"/>
        </Style>

        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Width" Value="{DynamicResource CardWidth}"/>
            <Setter Property="Height" Value="118"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="11,10" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="Shift" Y="0"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="Bd" Property="Effect" Value="{DynamicResource CardHoverEffect}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文件夹卡片 -->
        <DataTemplate DataType="{x:Type models:Category}">
            <Button Style="{StaticResource CardButton}" Click="Card_Click" ToolTip="{Binding Name}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource FolderTileBrush}">
                            <TextBlock Text="&#xF12B;" Style="{StaticResource IconText}" FontSize="15" Foreground="{DynamicResource FolderTileGlyphBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="分类" FontSize="10" Margin="0,3,0,0" Foreground="{DynamicResource ThirdlyTextBrush}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource CardDescription}"/>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- 工具卡片 -->
        <DataTemplate DataType="{x:Type models:Tool}">
            <Button Style="{StaticResource CardButton}" Click="Card_Click" ToolTip="{Binding Description}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="启动" Click="CardLaunch_Click"/>
                        <MenuItem Header="打开目录" Click="CardOpenFolder_Click"/>
                        <MenuItem Header="复制路径" Click="CardCopyPath_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Tile" Width="34" Height="34" CornerRadius="9" Background="{DynamicResource CmdTileBrush}">
                            <TextBlock x:Name="Glyph" Text="&#xE756;" Style="{StaticResource IconText}" FontSize="15" Foreground="{DynamicResource CmdTileGlyphBrush}"/>
                        </Border>
                        <!-- 程序自带图标，覆盖在默认图块上 -->
                        <Border x:Name="IconTile" Width="34" Height="34" CornerRadius="9"
                                Background="{DynamicResource ThirdlyRegionBrush}" BorderBrush="{DynamicResource SecondaryBorderBrush}" BorderThickness="1">
                            <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                            <Border Style="{StaticResource Badge}" Padding="4,0" Margin="0,3,0,0" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding ModeText}" FontSize="9" Foreground="{DynamicResource BadgeTextBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="Desc" Text="{Binding Description}" Style="{StaticResource CardDescription}"/>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Cmd}" Value="1">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xECAA;"/>
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource ToolTileGlyphBrush}"/>
                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource ToolTileBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="IconTile" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Description}" Value="">
                    <Setter TargetName="Desc" Property="Text" Value="暂无描述"/>
                    <Setter TargetName="Desc" Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧分类 -->
        <Border Style="{StaticResource PanelBorder}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="14,12,12,4">
                    <TextBlock x:Name="TotalText" DockPanel.Dock="Right" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="分类" Style="{StaticResource SectionTitle}"/>
                </DockPanel>
                <TreeView x:Name="ToolTreeView" Style="{StaticResource ModernTreeView}"
                          SelectedItemChanged="ToolTreeView_SelectedItemChanged"
                          PreviewMouseLeftButtonUp="ToolTreeView_PreviewMouseLeftButtonUp"/>
            </DockPanel>
        </Border>

        <!-- 右侧内容 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="&#xE72B;" ToolTip="返回上一级" Style="{StaticResource IconButton}"
                        Margin="0,0,6,0" Visibility="Collapsed" Click="BackButton_Click"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="全部工具" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PageSubtitle" Style="{StaticResource MutedText}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBox x:Name="SearchBox" Grid.Column="2" Width="210" Style="{StaticResource SearchBox}"
                         Tag="搜索名称 / 描述 / 路径" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
            </Grid>

            <Grid Grid.Row="1">
                <!-- 卡片列表 -->
                <!-- 按行虚拟化：每一项是一行卡片，只创建可见的行，工具很多时也不卡 -->
                <ItemsControl x:Name="CardsHost" Padding="0,2,0,0" SizeChanged="CardsHost_SizeChanged"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.CacheLength="2" VirtualizingPanel.CacheLengthUnit="Item">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer x:Name="PART_Scroll" Focusable="False" CanContentScroll="True" Padding="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="34" Foreground="{DynamicResource ThirdlyTextBrush}"/>
                    <TextBlock x:Name="EmptyText" Text="这里还没有工具" Margin="0,12,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="可以在「数据库」页添加分类与工具" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 工具详情 -->
                <ScrollViewer x:Name="DetailsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Border Style="{StaticResource PanelBorder}" Padding="20" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Width="76" Height="76" CornerRadius="16" BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1"
                                        Effect="{DynamicResource NeonGlow}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="/images/model.png" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="DetailIconTile" Width="76" Height="76" CornerRadius="16"
                                        Background="{DynamicResource ThirdlyRegionBrush}" BorderBrush="{DynamicResource AccentSoftBorderBrush}"
                                        BorderThickness="1" Effect="{DynamicResource NeonGlow}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image Source="{Binding Icon}" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,2,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Style="{StaticResource Badge}">
                                            <TextBlock Text="{Binding ModeText}" FontSize="10" Foreground="{DynamicResource BadgeTextBrush}"/>
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Background="{DynamicResource Badge2Brush}"
                                                BorderBrush="{DynamicResource Badge2BorderBrush}">
                                            <TextBlock FontSize="10" Foreground="{DynamicResource Badge2TextBrush}">
                                                <Run Text="ID"/>
                                                <Run Text="{Binding Id, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock x:Name="DetailPathText" Style="{StaticResource MutedText}" Margin="10,0,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="目录" Style="{StaticResource MutedText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ToolPath}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolPath}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RunLabel" Grid.Row="1" Text="程序" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
                                <TextBlock x:Name="RunValue" Grid.Row="1" Grid.Column="1" Text="{Binding RUN}" Margin="0,10,0,0"
                                           FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CommandLabel" Grid.Row="2" Text="命令" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
                                <ComboBox x:Name="CommandComboBox" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" IsEditable="True"
                                          FontFamily="{StaticResource MonoFont}" FontSize="12" Height="32"/>
                                <TextBlock x:Name="TerminalLabel" Grid.Row="3" Text="终端" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
                                <ComboBox x:Name="TerminalModeComboBox" Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" Height="32"
                                          Width="200" HorizontalAlignment="Left" FontSize="12"
                                          SelectionChanged="TerminalModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="内置终端（在本程序中显示）" Tag="Builtin"/>
                                    <ComboBoxItem Content="系统终端（新开 cmd 窗口）" Tag="System"/>
                                </ComboBox>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button x:Name="StartButton" Style="{StaticResource AccentButton}" Click="StartTool_Click" Padding="18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="启动"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OpenLocalFolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="打开目录"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="CopyPath_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="复制路径"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
