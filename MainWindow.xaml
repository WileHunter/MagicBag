<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:WpfApp3"
        mc:Ignorable="d"
        Icon="/images/icons8.png"
        Title="MagicBag"
        Width="820" Height="540"
        MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        BorderBrush="{DynamicResource SecondaryBorderBrush}"
        BorderThickness="1"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing"
        StateChanged="MainWindow_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <!-- 背景层 -->
        <Rectangle Fill="{DynamicResource GlowBrush}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource GlowBrush2}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource GridPatternBrush}" IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 + 导航 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="14,0,18,0" VerticalAlignment="Center">
                    <Grid Width="24" Height="24">
                        <Border CornerRadius="7" Background="{DynamicResource LogoTileBrush}" Effect="{DynamicResource NeonGlow}"
                                BorderBrush="{DynamicResource SecondaryBorderBrush}" BorderThickness="0.5"/>
                        <Image Source="/images/icons8.png" Width="16" Height="16"/>
                    </Grid>
                    <TextBlock Text="MagicBag" FontSize="14" FontWeight="Bold" Margin="9,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TitleBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="NavTools" Content="工具集" Tag="&#xE90F;" GroupName="Nav" IsChecked="True"
                                 Style="{StaticResource NavTab}" WindowChrome.IsHitTestVisibleInChrome="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavTerm" Content="终端" Tag="&#xE756;" GroupName="Nav"
                                 Style="{StaticResource NavTab}" WindowChrome.IsHitTestVisibleInChrome="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavNotes" Content="笔记本" Tag="&#xE70B;" GroupName="Nav"
                                 Style="{StaticResource NavTab}" WindowChrome.IsHitTestVisibleInChrome="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavData" Content="数据库" Tag="&#xE8F1;" GroupName="Nav"
                                 Style="{StaticResource NavTab}" WindowChrome.IsHitTestVisibleInChrome="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAbout" Content="关于" Tag="&#xE946;" GroupName="Nav"
                                 Style="{StaticResource NavTab}" WindowChrome.IsHitTestVisibleInChrome="True" Checked="Nav_Checked"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="ThemeButton" Content="&#xE790;" ToolTip="切换配色" Style="{StaticResource CaptionButton}" FontSize="13"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="ThemeButton_Click"/>
                    <Button Content="&#xE921;" ToolTip="最小化" Style="{StaticResource CaptionButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click"/>
                    <Button x:Name="MaxButton" Content="&#xE922;" ToolTip="最大化" Style="{StaticResource CaptionButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click"/>
                    <Button Content="&#xE8BB;" ToolTip="关闭" Style="{StaticResource CaptionCloseButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
                </StackPanel>

                <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False"
                        Background="{DynamicResource HeaderLineBrush}"/>
            </Grid>

            <!-- 页面 -->
            <Grid Grid.Row="1" x:Name="PageHost" Margin="10,10,10,10">
                <local:ToolsView x:Name="ToolsViewControl"/>
                <local:TerminalView x:Name="TerminalViewControl" Visibility="Collapsed"/>
                <local:NotebookView x:Name="NotebookViewControl" Visibility="Collapsed"/>
                <local:DatabaseView x:Name="DatabaseViewControl" Visibility="Collapsed"/>
                <local:AboutView x:Name="AboutViewControl" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- 全局提示 -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="0,48,8,0" Panel.ZIndex="100">
            <StackPanel hc:Growl.Token="AppMsg" VerticalAlignment="Top"/>
        </ScrollViewer>
    </Grid>
</Window>
