<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== 配色：墨白（黑 / 白 / 灰） ===================== -->
    <Color x:Key="LightPrimaryColor">#262626</Color>
    <Color x:Key="PrimaryColor">#FAFAFA</Color>
    <Color x:Key="DarkPrimaryColor">#D4D4D4</Color>

    <Color x:Key="LightDangerColor">#2A1414</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="DarkDangerColor">#DC2626</Color>

    <Color x:Key="LightWarningColor">#2A2210</Color>
    <Color x:Key="WarningColor">#EAB308</Color>
    <Color x:Key="DarkWarningColor">#CA8A04</Color>

    <Color x:Key="LightInfoColor">#262626</Color>
    <Color x:Key="InfoColor">#E5E5E5</Color>
    <Color x:Key="DarkInfoColor">#A3A3A3</Color>

    <Color x:Key="LightSuccessColor">#14261A</Color>
    <Color x:Key="SuccessColor">#4ADE80</Color>
    <Color x:Key="DarkSuccessColor">#16A34A</Color>

    <Color x:Key="PrimaryTextColor">#EDEDED</Color>
    <Color x:Key="SecondaryTextColor">#A1A1A1</Color>
    <Color x:Key="ThirdlyTextColor">#6B6B6B</Color>
    <Color x:Key="ReverseTextColor">#0A0A0A</Color>
    <!-- 主色为浅色，压在主色上的文字/图标用深色 -->
    <Color x:Key="TextIconColor">#0A0A0A</Color>

    <Color x:Key="BorderColor">#262626</Color>
    <Color x:Key="SecondaryBorderColor">#3A3A3A</Color>
    <Color x:Key="BackgroundColor">#0A0A0A</Color>
    <Color x:Key="RegionColor">#121212</Color>
    <Color x:Key="SecondaryRegionColor">#1A1A1A</Color>
    <Color x:Key="ThirdlyRegionColor">#262626</Color>
    <Color x:Key="TitleColor">#FFFFFF</Color>
    <Color x:Key="SecondaryTitleColor">#8A8A8A</Color>

    <Color x:Key="DefaultColor">#1A1A1A</Color>
    <Color x:Key="DarkDefaultColor">#262626</Color>

    <Color x:Key="AccentColor">#FFFFFF</Color>
    <Color x:Key="DarkAccentColor">#A3A3A3</Color>

    <Color x:Key="DarkMaskColor">#B30A0A0A</Color>
    <Color x:Key="DarkOpacityColor">#66000000</Color>

    <Color x:Key="NeonColor">#FFFFFF</Color>
    <Color x:Key="VioletColor">#A3A3A3</Color>

    <!-- ===================== HandyControl 画刷 ===================== -->
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="{StaticResource LightPrimaryColor}"/>
    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource DarkPrimaryColor}" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{StaticResource DarkPrimaryColor}"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="{StaticResource ThirdlyTextColor}"/>
    <SolidColorBrush x:Key="ReverseTextBrush" Color="{StaticResource ReverseTextColor}"/>
    <SolidColorBrush x:Key="TextIconBrush" Color="{StaticResource TextIconColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="{StaticResource SecondaryBorderColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="RegionBrush" Color="{StaticResource RegionColor}"/>
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{StaticResource SecondaryRegionColor}"/>
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="{StaticResource ThirdlyRegionColor}"/>
    <LinearGradientBrush x:Key="TitleBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource TitleColor}" Offset="0"/>
        <GradientStop Color="{StaticResource SecondaryTitleColor}" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="DefaultBrush" Color="{StaticResource DefaultColor}"/>
    <SolidColorBrush x:Key="DarkDefaultBrush" Color="{StaticResource DarkDefaultColor}"/>

    <SolidColorBrush x:Key="LightDangerBrush" Color="{StaticResource LightDangerColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DarkDangerBrush" Color="{StaticResource DarkDangerColor}"/>

    <SolidColorBrush x:Key="LightWarningBrush" Color="{StaticResource LightWarningColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DarkWarningBrush" Color="{StaticResource DarkWarningColor}"/>

    <SolidColorBrush x:Key="LightInfoBrush" Color="{StaticResource LightInfoColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="DarkInfoBrush" Color="{StaticResource DarkInfoColor}"/>

    <SolidColorBrush x:Key="LightSuccessBrush" Color="{StaticResource LightSuccessColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DarkSuccessBrush" Color="{StaticResource DarkSuccessColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="DarkAccentBrush" Color="{StaticResource DarkAccentColor}"/>
    <SolidColorBrush x:Key="DarkMaskBrush" Color="{StaticResource DarkMaskColor}"/>
    <SolidColorBrush x:Key="DarkOpacityBrush" Color="{StaticResource DarkOpacityColor}"/>

    <!-- ===================== 应用画刷 ===================== -->
    <SolidColorBrush x:Key="NeonBrush" Color="{StaticResource NeonColor}"/>
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="SelectedItemBrush" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="HoverItemBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#E6111111"/>
    <SolidColorBrush x:Key="InputBrush" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="GhostBrush" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="GhostHoverBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="NavCheckedBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="NavCheckedBorderBrush" Color="#2EFFFFFF"/>

    <SolidColorBrush x:Key="BadgeBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="Badge2Brush" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="Badge2BorderBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Badge2TextBrush" Color="#A3A3A3"/>

    <SolidColorBrush x:Key="CardBrush" Color="#CC141414"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F01B1B1B"/>
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#59FFFFFF"/>
    <DropShadowEffect x:Key="CardHoverEffect" Color="#000000" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.6"/>

    <LinearGradientBrush x:Key="HeaderLineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#26FFFFFF" Offset="0.3"/>
        <GradientStop Color="#26FFFFFF" Offset="0.7"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoTileBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2E2E2E" Offset="0"/>
        <GradientStop Color="#171717" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoTextBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#C8C8C8" Offset="0.6"/>
        <GradientStop Color="#7A7A7A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoRingBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#3A3A3A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LogoDiscBrush" Color="#CC161616"/>

    <!-- 卡片图块：界面保持黑白灰，图标用低饱和的柔和色点缀，便于区分 -->
    <SolidColorBrush x:Key="FolderTileBrush" Color="#2BE0A84F"/>
    <SolidColorBrush x:Key="FolderTileGlyphBrush" Color="#E8B86A"/>
    <SolidColorBrush x:Key="ToolTileBrush" Color="#2B5B8DEF"/>
    <SolidColorBrush x:Key="ToolTileGlyphBrush" Color="#8DB2F5"/>
    <SolidColorBrush x:Key="CmdTileBrush" Color="#2B53B987"/>
    <SolidColorBrush x:Key="CmdTileGlyphBrush" Color="#7DD3A5"/>

    <!-- 树 / 列表小图标 -->
    <SolidColorBrush x:Key="ChipAllBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="ChipAllFgBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="ChipFolderBrush" Color="#26E0A84F"/>
    <SolidColorBrush x:Key="ChipFolderFgBrush" Color="#E8B86A"/>
    <SolidColorBrush x:Key="ChipCmdBrush" Color="#2453B987"/>
    <SolidColorBrush x:Key="ChipCmdFgBrush" Color="#7DD3A5"/>
    <SolidColorBrush x:Key="ChipExeBrush" Color="#245B8DEF"/>
    <SolidColorBrush x:Key="ChipExeFgBrush" Color="#8DB2F5"/>

    <SolidColorBrush x:Key="NoteChip0Brush" Color="#265B8DEF"/>
    <SolidColorBrush x:Key="NoteChip0FgBrush" Color="#8DB2F5"/>
    <SolidColorBrush x:Key="NoteChip1Brush" Color="#269D7FD6"/>
    <SolidColorBrush x:Key="NoteChip1FgBrush" Color="#B9A2E6"/>
    <SolidColorBrush x:Key="NoteChip2Brush" Color="#2653B987"/>
    <SolidColorBrush x:Key="NoteChip2FgBrush" Color="#7DD3A5"/>
    <SolidColorBrush x:Key="NoteChip3Brush" Color="#26E0A84F"/>
    <SolidColorBrush x:Key="NoteChip3FgBrush" Color="#E8B86A"/>
    <SolidColorBrush x:Key="NoteChip4Brush" Color="#26E07F9C"/>
    <SolidColorBrush x:Key="NoteChip4FgBrush" Color="#EBA0B6"/>
    <SolidColorBrush x:Key="NoteChip5Brush" Color="#2650B8B3"/>
    <SolidColorBrush x:Key="NoteChip5FgBrush" Color="#7CCFCB"/>

    <!-- 终端 -->
    <SolidColorBrush x:Key="TermBackgroundBrush" Color="#050505"/>
    <SolidColorBrush x:Key="TermForegroundBrush" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="TermPromptBrush" Color="#7DD3A5"/>
    <SolidColorBrush x:Key="TermSelectionBrush" Color="#A3A3A3"/>
    <SolidColorBrush x:Key="TermRunningBrush" Color="#7DD3A5"/>
    <SolidColorBrush x:Key="TermIdleBrush" Color="#6B6B6B"/>

    <!-- 笔记纸张 -->
    <SolidColorBrush x:Key="PaperBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="PaperBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="PaperCaretBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="PaperSelectionBrush" Color="#525252"/>
    <SolidColorBrush x:Key="PaperIconBrush" Color="#A3A3A3"/>
    <SolidColorBrush x:Key="PaperMutedBrush" Color="#737373"/>
    <DropShadowEffect x:Key="PaperGlow" Color="#000000" BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.55"/>

    <!-- 窗口背景：近黑 + 极淡顶部光 + 细网格 -->
    <DrawingBrush x:Key="GridPatternBrush" TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute" Opacity="0.035">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Brush="#FFFFFF" Thickness="0.6"/>
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M0,0 L28,0 M0,0 L0,28"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <RadialGradientBrush x:Key="GlowBrush" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.75" RadiusY="0.7">
        <GradientStop Color="#12FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowBrush2" Center="1,1" GradientOrigin="1,1" RadiusX="0.5" RadiusY="0.6">
        <GradientStop Color="#08FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </RadialGradientBrush>

    <DropShadowEffect x:Key="NeonGlow" Color="#FFFFFF" BlurRadius="12" ShadowDepth="0" Opacity="0.18"/>
    <DropShadowEffect x:Key="SoftShadow" Color="#000000" BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.6"/>
    <DropShadowEffect x:Key="AccentGlow" Color="#000000" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.5"/>
    <DropShadowEffect x:Key="AccentGlowHover" Color="#FFFFFF" BlurRadius="14" ShadowDepth="0" Opacity="0.22"/>

</ResourceDictionary>
