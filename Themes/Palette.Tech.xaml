<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== 配色：科技蓝（覆盖 HandyControl 暗色皮肤） ===================== -->
    <Color x:Key="LightPrimaryColor">#0E3A5C</Color>
    <Color x:Key="PrimaryColor">#0EA5E9</Color>
    <Color x:Key="DarkPrimaryColor">#6366F1</Color>

    <Color x:Key="LightDangerColor">#3F1220</Color>
    <Color x:Key="DangerColor">#F43F5E</Color>
    <Color x:Key="DarkDangerColor">#E11D48</Color>

    <Color x:Key="LightWarningColor">#3D2E0B</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DarkWarningColor">#D97706</Color>

    <Color x:Key="LightInfoColor">#0B3442</Color>
    <Color x:Key="InfoColor">#22D3EE</Color>
    <Color x:Key="DarkInfoColor">#06B6D4</Color>

    <Color x:Key="LightSuccessColor">#0B3A2C</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="DarkSuccessColor">#059669</Color>

    <Color x:Key="PrimaryTextColor">#E6EDF7</Color>
    <Color x:Key="SecondaryTextColor">#8A9BB8</Color>
    <Color x:Key="ThirdlyTextColor">#5B6B88</Color>
    <Color x:Key="ReverseTextColor">#0B1120</Color>
    <Color x:Key="TextIconColor">#FFFFFF</Color>

    <Color x:Key="BorderColor">#24324F</Color>
    <Color x:Key="SecondaryBorderColor">#33466E</Color>
    <Color x:Key="BackgroundColor">#0B1120</Color>
    <Color x:Key="RegionColor">#111A2E</Color>
    <Color x:Key="SecondaryRegionColor">#18233B</Color>
    <Color x:Key="ThirdlyRegionColor">#22304D</Color>
    <Color x:Key="TitleColor">#0EA5E9</Color>
    <Color x:Key="SecondaryTitleColor">#6366F1</Color>

    <Color x:Key="DefaultColor">#18233B</Color>
    <Color x:Key="DarkDefaultColor">#22304D</Color>

    <Color x:Key="AccentColor">#22D3EE</Color>
    <Color x:Key="DarkAccentColor">#0891B2</Color>

    <Color x:Key="DarkMaskColor">#990B1120</Color>
    <Color x:Key="DarkOpacityColor">#66000000</Color>

    <Color x:Key="NeonColor">#22D3EE</Color>
    <Color x:Key="VioletColor">#8B5CF6</Color>

    <!-- ===================== HandyControl 画刷 ===================== -->
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="{StaticResource LightPrimaryColor}"/>
    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource DarkPrimaryColor}" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{StaticResource DarkPrimaryColor}"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="{StaticResource ThirdlyTextColor}"/>
    <SolidColorBrush x:Key="ReverseTextBrush" Color="{StaticResource ReverseTextColor}"/>
    <SolidColorBrush x:Key="TextIconBrush" Color="{StaticResource TextIconColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="{StaticResource SecondaryBorderColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="RegionBrush" Color="{StaticResource RegionColor}"/>
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{StaticResource SecondaryRegionColor}"/>
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="{StaticResource ThirdlyRegionColor}"/>
    <LinearGradientBrush x:Key="TitleBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource TitleColor}" Offset="0"/>
        <GradientStop Color="{StaticResource SecondaryTitleColor}" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="DefaultBrush" Color="{StaticResource DefaultColor}"/>
    <SolidColorBrush x:Key="DarkDefaultBrush" Color="{StaticResource DarkDefaultColor}"/>

    <SolidColorBrush x:Key="LightDangerBrush" Color="{StaticResource LightDangerColor}"/>
    <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource DangerColor}" Offset="0"/>
        <GradientStop Color="{StaticResource DarkDangerColor}" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DarkDangerBrush" Color="{StaticResource DarkDangerColor}"/>

    <SolidColorBrush x:Key="LightWarningBrush" Color="{StaticResource LightWarningColor}"/>
    <LinearGradientBrush x:Key="WarningBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource WarningColor}" Offset="0"/>
        <GradientStop Color="{StaticResource DarkWarningColor}" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DarkWarningBrush" Color="{StaticResource DarkWarningColor}"/>

    <SolidColorBrush x:Key="LightInfoBrush" Color="{StaticResource LightInfoColor}"/>
    <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource InfoColor}" Offset="0"/>
        <GradientStop Color="{StaticResource DarkInfoColor}" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DarkInfoBrush" Color="{StaticResource DarkInfoColor}"/>

    <SolidColorBrush x:Key="LightSuccessBrush" Color="{StaticResource LightSuccessColor}"/>
    <LinearGradientBrush x:Key="SuccessBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource SuccessColor}" Offset="0"/>
        <GradientStop Color="{StaticResource DarkSuccessColor}" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DarkSuccessBrush" Color="{StaticResource DarkSuccessColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="DarkAccentBrush" Color="{StaticResource DarkAccentColor}"/>
    <SolidColorBrush x:Key="DarkMaskBrush" Color="{StaticResource DarkMaskColor}"/>
    <SolidColorBrush x:Key="DarkOpacityBrush" Color="{StaticResource DarkOpacityColor}"/>

    <!-- ===================== 应用画刷 ===================== -->
    <SolidColorBrush x:Key="NeonBrush" Color="{StaticResource NeonColor}"/>
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectedItemBrush" Color="#1A0EA5E9"/>
    <SolidColorBrush x:Key="HoverItemBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#CC111A2E"/>
    <SolidColorBrush x:Key="InputBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="GhostBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="GhostHoverBrush" Color="#140EA5E9"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#260EA5E9"/>
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#660EA5E9"/>
    <SolidColorBrush x:Key="NavCheckedBrush" Color="#1F0EA5E9"/>
    <SolidColorBrush x:Key="NavCheckedBorderBrush" Color="#4D0EA5E9"/>

    <SolidColorBrush x:Key="BadgeBrush" Color="#1A22D3EE"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#4022D3EE"/>
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#22D3EE"/>
    <SolidColorBrush x:Key="Badge2Brush" Color="#1A8B5CF6"/>
    <SolidColorBrush x:Key="Badge2BorderBrush" Color="#408B5CF6"/>
    <SolidColorBrush x:Key="Badge2TextBrush" Color="#C4B5FD"/>

    <SolidColorBrush x:Key="CardBrush" Color="#B3111A2E"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#E618233B"/>
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#9922D3EE"/>
    <DropShadowEffect x:Key="CardHoverEffect" Color="#22D3EE" BlurRadius="14" ShadowDepth="0" Opacity="0.3"/>

    <LinearGradientBrush x:Key="HeaderLineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#000EA5E9" Offset="0"/>
        <GradientStop Color="#660EA5E9" Offset="0.3"/>
        <GradientStop Color="#668B5CF6" Offset="0.7"/>
        <GradientStop Color="#008B5CF6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoTileBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0EA5E9" Offset="0"/>
        <GradientStop Color="#6366F1" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoTextBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#22D3EE" Offset="0"/>
        <GradientStop Color="#6366F1" Offset="0.6"/>
        <GradientStop Color="#8B5CF6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoRingBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22D3EE" Offset="0"/>
        <GradientStop Color="#8B5CF6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LogoDiscBrush" Color="#B3111A2E"/>

    <!-- 卡片图块 -->
    <LinearGradientBrush x:Key="FolderTileBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FBBF24" Offset="0"/>
        <GradientStop Color="#F97316" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FolderTileGlyphBrush" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="ToolTileBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22D3EE" Offset="0"/>
        <GradientStop Color="#3B82F6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ToolTileGlyphBrush" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="CmdTileBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#34D399" Offset="0"/>
        <GradientStop Color="#059669" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CmdTileGlyphBrush" Color="#FFFFFF"/>

    <!-- 树 / 列表小图标（底色 + 前景） -->
    <SolidColorBrush x:Key="ChipAllBrush" Color="#2622D3EE"/>
    <SolidColorBrush x:Key="ChipAllFgBrush" Color="#22D3EE"/>
    <SolidColorBrush x:Key="ChipFolderBrush" Color="#26F59E0B"/>
    <SolidColorBrush x:Key="ChipFolderFgBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="ChipCmdBrush" Color="#2610B981"/>
    <SolidColorBrush x:Key="ChipCmdFgBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="ChipExeBrush" Color="#263B82F6"/>
    <SolidColorBrush x:Key="ChipExeFgBrush" Color="#60A5FA"/>

    <SolidColorBrush x:Key="NoteChip0Brush" Color="#2E0EA5E9"/>
    <SolidColorBrush x:Key="NoteChip0FgBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="NoteChip1Brush" Color="#2E8B5CF6"/>
    <SolidColorBrush x:Key="NoteChip1FgBrush" Color="#A78BFA"/>
    <SolidColorBrush x:Key="NoteChip2Brush" Color="#2E10B981"/>
    <SolidColorBrush x:Key="NoteChip2FgBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="NoteChip3Brush" Color="#2EF59E0B"/>
    <SolidColorBrush x:Key="NoteChip3FgBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="NoteChip4Brush" Color="#2EEC4899"/>
    <SolidColorBrush x:Key="NoteChip4FgBrush" Color="#F472B6"/>
    <SolidColorBrush x:Key="NoteChip5Brush" Color="#2EF43F5E"/>
    <SolidColorBrush x:Key="NoteChip5FgBrush" Color="#FB7185"/>

    <!-- 终端 -->
    <SolidColorBrush x:Key="TermBackgroundBrush" Color="#060A14"/>
    <SolidColorBrush x:Key="TermForegroundBrush" Color="#C9D7EA"/>
    <SolidColorBrush x:Key="TermPromptBrush" Color="#22D3EE"/>
    <SolidColorBrush x:Key="TermSelectionBrush" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="TermRunningBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="TermIdleBrush" Color="#5B6B88"/>

    <!-- 笔记纸张 -->
    <SolidColorBrush x:Key="PaperBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="PaperBorderBrush" Color="#334A6A"/>
    <SolidColorBrush x:Key="PaperCaretBrush" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="PaperSelectionBrush" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="PaperIconBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="PaperMutedBrush" Color="#64748B"/>
    <DropShadowEffect x:Key="PaperGlow" Color="#0EA5E9" BlurRadius="18" ShadowDepth="0" Opacity="0.12"/>

    <!-- 窗口背景：深色 + 角落光晕 + 极淡网格 -->
    <DrawingBrush x:Key="GridPatternBrush" TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute" Opacity="0.05">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Brush="#9FB4D9" Thickness="0.6"/>
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M0,0 L28,0 M0,0 L0,28"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <RadialGradientBrush x:Key="GlowBrush" Center="0.05,0" GradientOrigin="0.05,0" RadiusX="0.7" RadiusY="0.9">
        <GradientStop Color="#330EA5E9" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowBrush2" Center="1,1" GradientOrigin="1,1" RadiusX="0.6" RadiusY="0.8">
        <GradientStop Color="#268B5CF6" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>

    <DropShadowEffect x:Key="NeonGlow" Color="#22D3EE" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>
    <DropShadowEffect x:Key="SoftShadow" Color="#000000" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.35"/>
    <DropShadowEffect x:Key="AccentGlow" Color="#0EA5E9" BlurRadius="10" ShadowDepth="0" Opacity="0.25"/>
    <DropShadowEffect x:Key="AccentGlowHover" Color="#22D3EE" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>

</ResourceDictionary>
