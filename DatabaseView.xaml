<UserControl x:Class="WpfApp3.DatabaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:WpfApp3.Models"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="800">
    <UserControl.Resources>
        <ContextMenu x:Key="CategoryMenu">
            <MenuItem Header="新建子分类" Click="AddSubCategory_Click"/>
            <MenuItem Header="重命名" Click="RenameCategory_Click"/>
            <Separator/>
            <MenuItem Header="删除分类" Click="DeleteCategory_Click"/>
        </ContextMenu>

        <Style x:Key="CategoryItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="ContextMenu" Value="{StaticResource CategoryMenu}"/>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style x:Key="CompactCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="6,0"/>
        </Style>
        <Style x:Key="MonoCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="MutedCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="196"/>
            <ColumnDefinition x:Name="SidebarGapColumn" Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 分类树 ================= -->
        <Border x:Name="Sidebar" Style="{StaticResource PanelBorder}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="14,10,8,4">
                    <Button DockPanel.Dock="Right" Content="&#xE8F4;" ToolTip="新建顶层分类" Style="{StaticResource IconButton}"
                            Width="26" Height="26" Click="AddTopLevelCategory_Click"/>
                    <TextBlock Text="分类" Style="{StaticResource SectionTitle}"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="右键分类可新建子分类 / 重命名 / 删除" Style="{StaticResource MutedText}"
                           FontSize="10" Margin="14,4,8,8" TextWrapping="Wrap"/>
                <TreeView x:Name="CategoryTreeView" Style="{StaticResource ModernTreeView}"
                          ItemContainerStyle="{StaticResource CategoryItemStyle}"
                          SelectedItemChanged="CategoryTreeView_SelectedItemChanged"
                          PreviewMouseRightButtonDown="CategoryTreeView_PreviewMouseRightButtonDown"
                          MouseDoubleClick="CategoryTreeView_MouseDoubleClick"
                          KeyDown="CategoryTreeView_KeyDown">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type models:Category}" ItemsSource="{Binding SubCategories}"
                                                  ItemContainerStyle="{StaticResource CategoryItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Chip}" Background="{DynamicResource ChipFolderBrush}">
                                    <TextBlock x:Name="FolderGlyph" Text="&#xF12B;" Style="{StaticResource ChipGlyph}"
                                               Foreground="{DynamicResource ChipFolderFgBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="新建顶层分类" Click="AddTopLevelCategory_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- ================= 工具表格 ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="SidebarToggle" Content="&#xE700;" ToolTip="显示/隐藏分类" Style="{StaticResource IconButton}"
                              IsChecked="True" Margin="0,0,8,0" Click="SidebarToggle_Click"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TitleText" Text="工具数据" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <Border x:Name="DirtyBadge" Style="{StaticResource Badge}" Margin="8,0,0,0" Visibility="Collapsed"
                                Background="#1AF59E0B" BorderBrush="#66F59E0B">
                            <TextBlock Text="未保存" FontSize="10" Foreground="{DynamicResource WarningBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedText}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Click="AddTool_Click" ToolTip="在当前分类添加工具" Padding="10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="添加"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerGhostButton}" Click="DeleteTool_Click" ToolTip="删除选中的工具 (Delete)"
                            Margin="6,0,0,0" Padding="10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="删除"/>
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource VSeparator}" Margin="8,0"/>
                    <Button Content="&#xE72C;" ToolTip="放弃修改并从磁盘重新加载" Style="{StaticResource IconButton}" Click="Reload_Click"/>
                    <Button Style="{StaticResource AccentButton}" Click="SaveJson_Click" ToolTip="保存到 tools.json (Ctrl+S)"
                            Margin="6,0,0,0" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="保存"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="2">
                <Grid>
                    <DataGrid x:Name="ToolsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              SelectionMode="Extended"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              FontSize="12"
                              RowHeight="34"
                              ColumnHeaderHeight="34"
                              CellStyle="{StaticResource CompactCell}"
                              HorizontalScrollBarVisibility="Disabled"
                              PreviewKeyDown="ToolsGrid_PreviewKeyDown"
                              ContextMenuOpening="ToolsGrid_ContextMenuOpening">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="选择程序..." Click="BrowseProgram_Click"/>
                                <MenuItem Header="选择目录..." Click="BrowseFolder_Click"/>
                                <MenuItem x:Name="MoveToMenu" Header="移动到"/>
                                <Separator/>
                                <MenuItem Header="添加工具" Click="AddTool_Click"/>
                                <MenuItem Header="删除" Click="DeleteTool_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="38" IsReadOnly="True"
                                                ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.1*" MinWidth="70"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="描述" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" MinWidth="70"
                                                ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTemplateColumn Header="方式" Width="72" SortMemberPath="Cmd">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" Padding="6,1">
                                            <TextBlock Text="{Binding ModeText}" FontSize="10" Foreground="{DynamicResource NeonBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{x:Static models:LaunchModeOption.All}"
                                                  SelectedValue="{Binding Cmd, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Value" DisplayMemberPath="Name"
                                                  Height="28" MinHeight="28" Padding="6,0" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="目录" Binding="{Binding ToolPath, UpdateSourceTrigger=PropertyChanged}" Width="1.5*" MinWidth="80"
                                                ElementStyle="{StaticResource MonoCellText}"/>
                            <DataGridTextColumn Header="程序" Binding="{Binding RUN, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="60"
                                                ElementStyle="{StaticResource MonoCellText}"/>
                            <DataGridTextColumn Header="命令（; 分隔）" Binding="{Binding Commond, UpdateSourceTrigger=PropertyChanged}"
                                                Width="1.6*" MinWidth="80" ElementStyle="{StaticResource MonoCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock x:Name="EmptyIcon" Text="&#xF12B;" Style="{StaticResource IconText}" FontSize="32"
                                   Foreground="{DynamicResource ThirdlyTextBrush}"/>
                        <TextBlock x:Name="EmptyText" Text="在左侧选择一个分类" Margin="0,12,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
