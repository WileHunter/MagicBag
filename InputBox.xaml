<Window x:Class="WpfApp3.InputBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="340"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Margin="16" CornerRadius="12" Background="{DynamicResource RegionBrush}"
            BorderBrush="{DynamicResource SecondaryBorderBrush}" BorderThickness="1"
            Effect="{DynamicResource SoftShadow}">
        <Grid>
            <Border Height="2" VerticalAlignment="Top" CornerRadius="12,12,0,0" Background="{DynamicResource PrimaryBrush}"/>
            <StackPanel Margin="20,18,20,16">
                <TextBlock x:Name="TitleTextBlock" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                <TextBlock x:Name="MessageTextBlock" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" Visibility="Collapsed"/>
                <TextBox x:Name="Boxx" Style="{StaticResource FieldBox}" Margin="0,4,0,0"
                         TextChanged="Boxx_TextChanged"/>
                <TextBlock x:Name="ErrorTextBlock" FontSize="11" Foreground="{DynamicResource DangerBrush}" Margin="2,6,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="取消" IsCancel="True" Width="72" Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0" Click="CancelButton_Click"/>
                    <Button x:Name="Done_Button" Content="确定" IsDefault="True" Width="72"
                            Style="{StaticResource AccentButton}" Click="Done_Button_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
